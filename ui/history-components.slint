import { ScrollView } from "std-widgets.slint";
import { HistoryEntry } from "models.slint";

export component HistoryItemsTab inherits Rectangle {
    background: transparent;

    in property <[HistoryEntry]> history-items;
    in-out property <int> selected-index: 0;
    in-out property <int> ctx-target-index: -1;
    in-out property <bool> ctx-visible: false;
    in-out property <int> ctx-selected: 0;
    in-out property <length> scroll-offset-y <=> history-scroll.viewport-y;
    out property <length> scroll-visible-height: history-scroll.visible-height;

    callback request-select-history-item(int);

    history-scroll := ScrollView {
        VerticalLayout {
            spacing: 4px;
            padding: 8px;

            for item[index] in root.history-items: Rectangle {
                height: 44px;
                clip: true;
                border-radius: 4px;
                background: hist-touch.pressed ? #b3cfff
                          : index == root.selected-index ? #cfe1ff
                          : hist-touch.has-hover ? #e0e0e0
                          : #f4f4f4;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 8px;
                    padding-top: 4px;
                    spacing: 6px;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-width: 1px;
                        border-color: item.used ? #2f6feb : #9aa4b2;
                        border-radius: 4px;
                        background: item.used ? #2f6feb : #ffffff;

                        Path {
                            x: 3px;
                            y: 4px;
                            width: 12px;
                            height: 9px;
                            visible: item.used;
                            commands: "M 1 4 L 4 7 L 11 1";
                            stroke: #ffffff;
                            stroke-width: 2px;
                            fill: #00000000;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: item.text;
                        color: #111111;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                }

                hist-touch := TouchArea {
                    clicked => {
                        root.selected-index = index;
                        root.request-select-history-item(index);
                    }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.ctx-target-index = index;
                            root.ctx-selected = 0;
                            root.ctx-visible = true;
                        }
                    }
                }
            }
        }
    }
}

export component HistoryContextOverlay inherits Rectangle {
    in-out property <bool> overlay-visible: false;
    in-out property <int> selected-index: 0;
    in-out property <int> target-index: -1;
    in property <length> overlay-width: 0px;
    in property <length> overlay-height: 0px;

    width: root.overlay-width;
    height: root.overlay-height;
    visible: root.overlay-visible;
    background: #00000040;

    callback request-save(int);
    callback request-move-to-front(int);
    callback request-bulk-paste-concat(int);
    callback request-bulk-paste-tab(int);
    callback request-bulk-paste-newline(int);

    TouchArea {
        clicked => {
            root.overlay-visible = false;
        }
    }

    Rectangle {
        x: (parent.width - 280px) / 2;
        y: (parent.height - 200px) / 2;
        width: 280px;
        height: 200px;
        background: white;
        border-width: 1px;
        border-color: #999999;
        border-radius: 6px;
        clip: true;

        VerticalLayout {
            spacing: 0px;
            padding: 4px;

            Rectangle {
                height: 34px;
                border-radius: 4px;
                background: root.selected-index == 0 ? #cfe1ff
                          : ctx-save-touch.has-hover ? #e8e8e8 : transparent;

                ctx-save-touch := TouchArea {
                    clicked => {
                        root.request-save(root.target-index);
                        root.overlay-visible = false;
                    }
                    moved => {
                        root.selected-index = 0;
                    }
                }

                Rectangle {
                    x: 10px;
                    y: 9px;
                    width: 14px;
                    height: 14px;
                    background: #00000000;

                    Path {
                        x: 1px;
                        y: 1px;
                        width: 12px;
                        height: 12px;
                        commands: "M 2 1 L 10 1 L 10 11 L 6 8 L 2 11 Z";
                        stroke: #111111;
                        stroke-width: 1px;
                        fill: #00000000;
                    }
                }

                Text {
                    text: "保存";
                    x: 30px;
                    color: #111111;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 34px;
                border-radius: 4px;
                background: root.selected-index == 1 ? #cfe1ff
                          : ctx-front-touch.has-hover ? #e8e8e8 : transparent;

                ctx-front-touch := TouchArea {
                    clicked => {
                        root.request-move-to-front(root.target-index);
                        root.overlay-visible = false;
                    }
                    moved => {
                        root.selected-index = 1;
                    }
                }

                Rectangle {
                    x: 10px;
                    y: 9px;
                    width: 14px;
                    height: 14px;
                    background: #00000000;

                    Path {
                        x: 1px;
                        y: 1px;
                        width: 12px;
                        height: 12px;
                        commands: "M 6 1 L 11 7 L 8 7 L 8 11 L 4 11 L 4 7 L 1 7 Z";
                        stroke: #111111;
                        stroke-width: 1px;
                        fill: #111111;
                    }
                }

                Text {
                    text: "最新に移動";
                    x: 30px;
                    color: #111111;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: #dddddd;
            }

            Rectangle {
                height: 34px;
                border-radius: 4px;
                background: root.selected-index == 2 ? #cfe1ff
                          : ctx-concat-touch.has-hover ? #e8e8e8 : transparent;

                ctx-concat-touch := TouchArea {
                    clicked => {
                        root.request-bulk-paste-concat(root.target-index);
                        root.overlay-visible = false;
                    }
                    moved => {
                        root.selected-index = 2;
                    }
                }

                Rectangle {
                    x: 10px;
                    y: 9px;
                    width: 14px;
                    height: 14px;
                    background: #00000000;

                    Path {
                        x: 1px;
                        y: 1px;
                        width: 12px;
                        height: 12px;
                        commands: "M 3 2 L 9 2 L 9 11 L 3 11 Z M 4 1 L 8 1 L 8 3 L 4 3 Z";
                        stroke: #111111;
                        stroke-width: 1px;
                        fill: #00000000;
                    }
                }

                Text {
                    text: "この行以上を一括貼付(連結)";
                    x: 30px;
                    color: #111111;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 34px;
                border-radius: 4px;
                background: root.selected-index == 3 ? #cfe1ff
                          : ctx-tab-touch.has-hover ? #e8e8e8 : transparent;

                ctx-tab-touch := TouchArea {
                    clicked => {
                        root.request-bulk-paste-tab(root.target-index);
                        root.overlay-visible = false;
                    }
                    moved => {
                        root.selected-index = 3;
                    }
                }

                Rectangle {
                    x: 10px;
                    y: 9px;
                    width: 14px;
                    height: 14px;
                    background: #00000000;

                    Path {
                        x: 1px;
                        y: 1px;
                        width: 12px;
                        height: 12px;
                        commands: "M 3 2 L 9 2 L 9 11 L 3 11 Z M 4 1 L 8 1 L 8 3 L 4 3 Z";
                        stroke: #111111;
                        stroke-width: 1px;
                        fill: #00000000;
                    }
                }

                Text {
                    text: "この行以上を一括貼付(Tab)";
                    x: 30px;
                    color: #111111;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 34px;
                border-radius: 4px;
                background: root.selected-index == 4 ? #cfe1ff
                          : ctx-nl-touch.has-hover ? #e8e8e8 : transparent;

                ctx-nl-touch := TouchArea {
                    clicked => {
                        root.request-bulk-paste-newline(root.target-index);
                        root.overlay-visible = false;
                    }
                    moved => {
                        root.selected-index = 4;
                    }
                }

                Rectangle {
                    x: 10px;
                    y: 9px;
                    width: 14px;
                    height: 14px;
                    background: #00000000;

                    Path {
                        x: 1px;
                        y: 1px;
                        width: 12px;
                        height: 12px;
                        commands: "M 3 2 L 9 2 L 9 11 L 3 11 Z M 4 1 L 8 1 L 8 3 L 4 3 Z";
                        stroke: #111111;
                        stroke-width: 1px;
                        fill: #00000000;
                    }
                }

                Text {
                    text: "この行以上を一括貼付(改行)";
                    x: 30px;
                    color: #111111;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
